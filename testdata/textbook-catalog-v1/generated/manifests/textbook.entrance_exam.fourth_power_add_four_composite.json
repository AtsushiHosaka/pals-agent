{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro n hn\n  obtain ⟨m, rfl⟩ : ∃ m, n = m + 2 := ⟨n - 2, by omega⟩\n  have e : (m + 2) ^ 4 + 4 = ((m + 2) ^ 2 + 2 * (m + 2) + 2) * ((m + 1) ^ 2 + 1) := by ring\n  rw [e]\n  apply Nat.not_prime_mul\n  · have : 0 < (m + 2) ^ 2 := by positivity\n    omega\n  · have : 0 < (m + 1) ^ 2 := by positivity\n    omega","recipe_id":"textbook.entrance_exam.fourth_power_add_four_composite","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ n : ℕ, 2 ≤ n → ¬ Nat.Prime (n ^ 4 + 4)","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}