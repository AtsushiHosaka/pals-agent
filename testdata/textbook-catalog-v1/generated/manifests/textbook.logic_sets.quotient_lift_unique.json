{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro α β s f h\n  refine ExistsUnique.intro (Quotient.lift f (fun a b hab => h a b hab)) (fun x => rfl) ?_\n  intro g hg\n  funext q\n  obtain ⟨x, rfl⟩ := Quotient.exists_rep q\n  exact hg x","recipe_id":"textbook.logic_sets.quotient_lift_unique","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (α β : Type*) (s : Setoid α) (f : α → β), (∀ x y, s.r x y → f x = f y) → ∃! g : Quotient s → β, ∀ x, g (Quotient.mk s x) = f x","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}