{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro a b n hb ha\n  have hp : a ^ n ≠ 0 := by positivity\n  rw [Nat.length_digits b _ hb hp, ← Real.natFloor_logb_natCast]\n  push_cast\n  rw [Real.logb_pow]","recipe_id":"textbook.school_exp_log.digit_count_of_power_floor_any_base","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (a b n : ℕ), 1 < b → 1 ≤ a → (Nat.digits b (a ^ n)).length = ⌊(n : ℝ) * Real.logb b (a : ℝ)⌋₊ + 1","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}