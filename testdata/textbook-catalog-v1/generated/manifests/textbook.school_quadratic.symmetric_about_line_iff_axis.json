{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro a b c k ha\n  constructor\n  · intro h\n    have h1 := h 1\n    rw [eq_div_iff (mul_ne_zero two_ne_zero ha)]\n    linear_combination (1 / 2) * h1\n  · intro hk t\n    have h2 : 2 * a * k + b = 0 := by\n      rw [hk]\n      field_simp\n      ring\n    linear_combination (2 * t) * h2","recipe_id":"textbook.school_quadratic.symmetric_about_line_iff_axis","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (a b c k : ℝ), a ≠ 0 → ((∀ t : ℝ, a * (k + t) ^ 2 + b * (k + t) + c = a * (k - t) ^ 2 + b * (k - t) + c) ↔ k = -b / (2 * a))","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}