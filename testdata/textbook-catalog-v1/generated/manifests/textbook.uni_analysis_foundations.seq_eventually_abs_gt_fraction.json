{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro a L c h hL _ hc1\n  have hpos : 0 < (1 - c) * |L| := mul_pos (by linarith) (abs_pos.2 hL)\n  obtain ⟨K, hK⟩ := h _ hpos\n  refine ⟨K, fun n hn => ?_⟩\n  have h1 := hK n hn\n  have h2 : |L| - |a n| ≤ |a n - L| := by\n    rw [abs_sub_comm]\n    exact abs_sub_abs_le_abs_sub L (a n)\n  have h3 : (1 - c) * |L| = |L| - c * |L| := by ring\n  linarith","recipe_id":"textbook.uni_analysis_foundations.seq_eventually_abs_gt_fraction","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (a : ℕ → ℝ) (L c : ℝ), (∀ ε : ℝ, 0 < ε → ∃ K : ℕ, ∀ n, K ≤ n → |a n - L| < ε) → L ≠ 0 → 0 < c → c < 1 → ∃ K : ℕ, ∀ n, K ≤ n → c * |L| < |a n|","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}