{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro f g a L M hf hg ε hε\n  obtain ⟨δ₁, hδ₁, h₁⟩ := hf (ε / 2) (by positivity)\n  obtain ⟨δ₂, hδ₂, h₂⟩ := hg (ε / 2) (by positivity)\n  refine ⟨min δ₁ δ₂, lt_min hδ₁ hδ₂, fun x h0 hx => ?_⟩\n  have h3 := h₁ x h0 (lt_of_lt_of_le hx (min_le_left _ _))\n  have h4 := h₂ x h0 (lt_of_lt_of_le hx (min_le_right _ _))\n  have h5 : f x + g x - (L + M) = (f x - L) + (g x - M) := by ring\n  rw [h5]\n  calc _ ≤ |f x - L| + |g x - M| := abs_add_le _ _\n    _ < ε := by linarith","recipe_id":"textbook.uni_analysis_foundations.eps_delta_limit_add","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (f g : ℝ → ℝ) (a L M : ℝ), (∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ x : ℝ, 0 < |x - a| → |x - a| < δ → |f x - L| < ε) → (∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ x : ℝ, 0 < |x - a| → |x - a| < δ → |g x - M| < ε) → ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ x : ℝ, 0 < |x - a| → |x - a| < δ → |f x + g x - (L + M)| < ε","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}