{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro a p q x ha\n  have h2 : a ^ (2 * x) = (a ^ x) ^ 2 := by\n    rw [mul_comm, Real.rpow_mul ha.le, Real.rpow_two]\n  rw [h2]\n  constructor\n  · intro h\n    exact ⟨a ^ x, Real.rpow_pos_of_pos ha x, h, rfl⟩\n  · rintro ⟨t, _, ht, rfl⟩\n    exact ht","recipe_id":"textbook.school_exp_log.exp_quadratic_substitution_positive","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (a p q x : ℝ), 0 < a → (a ^ (2 * x) + p * a ^ x + q = 0 ↔ ∃ t : ℝ, 0 < t ∧ t ^ 2 + p * t + q = 0 ∧ a ^ x = t)","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}