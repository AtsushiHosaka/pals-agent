{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro a b x y h hxy\n  obtain ⟨u, v, huv⟩ := Int.isCoprime_iff_gcd_eq_one.mpr h\n  refine ⟨u * y + v * x, ?_, ?_⟩\n  · linear_combination (-x) * huv + u * hxy\n  · linear_combination (-y) * huv - v * hxy","recipe_id":"textbook.school_integers.coprime_mul_eq_mul_param","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (a b x y : ℤ), Int.gcd a b = 1 → a * x = b * y → ∃ t : ℤ, x = b * t ∧ y = a * t","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}