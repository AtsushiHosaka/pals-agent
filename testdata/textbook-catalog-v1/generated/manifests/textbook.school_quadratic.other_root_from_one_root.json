{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro a b c r ha h\n  have key : ∀ x : ℝ, a * x ^ 2 + b * x + c = a * (x - r) * (x - (-b / a - r)) := by\n    intro x\n    have hc : c = -a * r ^ 2 - b * r := by linarith\n    subst hc\n    field_simp\n    ring\n  refine ⟨key, fun x => ?_⟩\n  rw [key x]\n  simp [ha, sub_eq_zero]","recipe_id":"textbook.school_quadratic.other_root_from_one_root","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (a b c r : ℝ), a ≠ 0 → a * r ^ 2 + b * r + c = 0 → (∀ x : ℝ, a * x ^ 2 + b * x + c = a * (x - r) * (x - (-b / a - r))) ∧ (∀ x : ℝ, a * x ^ 2 + b * x + c = 0 ↔ x = r ∨ x = -b / a - r)","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}