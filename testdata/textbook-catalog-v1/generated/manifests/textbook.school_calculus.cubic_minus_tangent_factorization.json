{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro a b c d t ha\n  constructor\n  · have h3 := (hasDerivAt_pow 3 t).const_mul a\n    have h2 := (hasDerivAt_pow 2 t).const_mul b\n    have h1 := (hasDerivAt_id' t).const_mul c\n    exact (((h3.fun_add h2).fun_add h1).add_const d).congr_deriv (by norm_num; ring)\n  · intro x\n    field_simp\n    ring","recipe_id":"textbook.school_calculus.cubic_minus_tangent_factorization","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (a b c d t : ℝ), a ≠ 0 → HasDerivAt (fun y => a * y ^ 3 + b * y ^ 2 + c * y + d) (3 * a * t ^ 2 + 2 * b * t + c) t ∧ ∀ x, (a * x ^ 3 + b * x ^ 2 + c * x + d) - ((a * t ^ 3 + b * t ^ 2 + c * t + d) + (3 * a * t ^ 2 + 2 * b * t + c) * (x - t)) = a * (x - t) ^ 2 * (x + 2 * t + b / a)","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}