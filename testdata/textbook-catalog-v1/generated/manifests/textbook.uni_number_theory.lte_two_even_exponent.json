{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro x y n hx hy hn\n  have hxy : (2 : ℤ) ∣ x - y := by omega\n  exact Int.two_pow_sub_pow hxy hx hn","recipe_id":"textbook.uni_number_theory.lte_two_even_exponent","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (x y : ℤ) (n : ℕ), ¬ (2 : ℤ) ∣ x → ¬ (2 : ℤ) ∣ y → Even n → emultiplicity (2 : ℤ) (x ^ n - y ^ n) + 1 = emultiplicity (2 : ℤ) (x + y) + emultiplicity (2 : ℤ) (x - y) + emultiplicity (2 : ℤ) (n : ℤ)","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}