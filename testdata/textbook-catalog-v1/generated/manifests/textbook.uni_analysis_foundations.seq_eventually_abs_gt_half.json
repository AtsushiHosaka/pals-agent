{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro a L h hL\n  obtain ⟨N, hN⟩ := h (|L| / 2) (by positivity)\n  refine ⟨N, fun n hn => ?_⟩\n  have h1 := hN n hn\n  have h2 : |L| - |a n| ≤ |a n - L| := by\n    rw [abs_sub_comm]; exact abs_sub_abs_le_abs_sub L (a n)\n  linarith","recipe_id":"textbook.uni_analysis_foundations.seq_eventually_abs_gt_half","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (a : ℕ → ℝ) (L : ℝ), (∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ n, N ≤ n → |a n - L| < ε) → L ≠ 0 → ∃ N : ℕ, ∀ n, N ≤ n → |L| / 2 < |a n|","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}