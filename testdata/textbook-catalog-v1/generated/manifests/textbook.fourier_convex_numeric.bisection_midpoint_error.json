{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro a b hstep n x hl hu\n  have hw : ∀ k, b k - a k = (b 0 - a 0) / 2 ^ k := by\n    intro k\n    induction k with\n    | zero => simp\n    | succ k ih =>\n      rw [hstep, ih, pow_succ]\n      field_simp\n  have h : (b 0 - a 0) / 2 ^ (n + 1) = (b n - a n) / 2 := by\n    rw [hw n, pow_succ]\n    field_simp\n  rw [h, abs_le]\n  constructor <;> linarith","recipe_id":"textbook.fourier_convex_numeric.bisection_midpoint_error","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (a b : ℕ → ℝ), (∀ k, b (k + 1) - a (k + 1) = (b k - a k) / 2) → ∀ (n : ℕ) (x : ℝ), a n ≤ x → x ≤ b n → |x - (a n + b n) / 2| ≤ (b 0 - a 0) / 2 ^ (n + 1)","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}