{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro a L M h1 h2\n  by_contra hne\n  have hpos : 0 < |L - M| / 2 := by\n    have := abs_pos.2 (sub_ne_zero.2 hne)\n    linarith\n  obtain ⟨K1, hK1⟩ := h1 _ hpos\n  obtain ⟨K2, hK2⟩ := h2 _ hpos\n  have h3 := hK1 (max K1 K2) (le_max_left _ _)\n  have h4 := hK2 (max K1 K2) (le_max_right _ _)\n  have h5 := abs_sub_le L (a (max K1 K2)) M\n  rw [abs_sub_comm L (a (max K1 K2))] at h5\n  linarith","recipe_id":"textbook.uni_analysis_foundations.seq_limit_unique_eps","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (a : ℕ → ℝ) (L M : ℝ), (∀ ε : ℝ, 0 < ε → ∃ K : ℕ, ∀ n, K ≤ n → |a n - L| < ε) → (∀ ε : ℝ, 0 < ε → ∃ K : ℕ, ∀ n, K ≤ n → |a n - M| < ε) → L = M","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}