{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro a b r x₀ y₀ p q h₀ h\n  linear_combination (-2 : ℝ) * h - h₀","recipe_id":"textbook.school_analytic_geometry.tangent_length_sq_eq_power","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (a b r x₀ y₀ p q : ℝ), (x₀ - a) ^ 2 + (y₀ - b) ^ 2 = r ^ 2 → (x₀ - a) * (p - x₀) + (y₀ - b) * (q - y₀) = 0 → (p - x₀) ^ 2 + (q - y₀) ^ 2 = (p - a) ^ 2 + (q - b) ^ 2 - r ^ 2","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}