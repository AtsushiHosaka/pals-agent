{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro a r n hr\n  have hr1 : r - 1 ≠ 0 := sub_ne_zero.mpr hr\n  induction n with\n  | zero => simp\n  | succ n ih =>\n    rw [Finset.sum_Icc_succ_top (by omega), ih, Nat.add_sub_cancel]\n    field_simp\n    ring","recipe_id":"textbook.school_sequences.geom_sum_ne_one","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (a r : ℝ) (n : ℕ), r ≠ 1 → ∑ k ∈ Finset.Icc 1 n, a * r ^ (k - 1) = a * (r ^ n - 1) / (r - 1)","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}