{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro a b p q x hab hxa hxb\n  have h1 : a - b ≠ 0 := sub_ne_zero.mpr hab\n  have h2 : b - a ≠ 0 := sub_ne_zero.mpr hab.symm\n  have h3 : x - a ≠ 0 := sub_ne_zero.mpr hxa\n  have h4 : x - b ≠ 0 := sub_ne_zero.mpr hxb\n  have h5 : b - a = -(a - b) := by ring\n  rw [h5]\n  field_simp\n  ring","recipe_id":"textbook.school_polynomials.partial_fraction_two_distinct_linear","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (a b p q x : ℝ), a ≠ b → x ≠ a → x ≠ b → (p * x + q) / ((x - a) * (x - b)) = ((p * a + q) / (a - b)) / (x - a) + ((p * b + q) / (b - a)) / (x - b)","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}