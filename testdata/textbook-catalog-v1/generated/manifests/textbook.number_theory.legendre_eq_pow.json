{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro p _ a hp2\n  have hodd := (Fact.out : Nat.Prime p).eq_two_or_odd.resolve_left hp2\n  have hdiv : (p - 1) / 2 = p / 2 := by omega\n  rw [hdiv, ← ZMod.intCast_eq_intCast_iff, Int.cast_pow]\n  exact legendreSym.eq_pow p a","recipe_id":"textbook.number_theory.legendre_eq_pow","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (p : ℕ) [Fact (Nat.Prime p)] (a : ℤ), p ≠ 2 → legendreSym p a ≡ a ^ ((p - 1) / 2) [ZMOD p]","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}