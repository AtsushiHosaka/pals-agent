{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro b k n hb\n  by_cases hn : n = 0\n  · subst hn\n    have : 0 < b ^ k := Nat.pow_pos (by omega)\n    simp\n    omega\n  · rw [Nat.length_digits b n hb hn, Nat.add_right_cancel_iff]\n    exact Nat.log_eq_iff (Or.inr ⟨hb, hn⟩)","recipe_id":"textbook.school_integers.digit_length_iff_pow_bounds","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (b k n : ℕ), 2 ≤ b → ((Nat.digits b n).length = k + 1 ↔ b ^ k ≤ n ∧ n < b ^ (k + 1))","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}