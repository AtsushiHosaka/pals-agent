{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro k m n _ _ h\n  have h2 := (ArithmeticFunction.isMultiplicative_sigma (k := k)).map_mul_of_coprime h\n  simpa only [ArithmeticFunction.sigma_apply] using h2","recipe_id":"textbook.number_theory.divisor_power_sum_multiplicative","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (k m n : ℕ), 0 < m → 0 < n → Nat.Coprime m n → ∑ d ∈ (m * n).divisors, d ^ k = (∑ d ∈ m.divisors, d ^ k) * ∑ d ∈ n.divisors, d ^ k","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}