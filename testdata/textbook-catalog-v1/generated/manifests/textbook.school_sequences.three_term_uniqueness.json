{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro a b F h1 h2 ha hb\n  have key : ∀ m : ℕ, a (m + 1) = b (m + 1) ∧ a (m + 2) = b (m + 2) := by\n    intro m\n    induction m with\n    | zero => exact ⟨h1, h2⟩\n    | succ m ih =>\n      refine ⟨ih.2, ?_⟩\n      rw [ha (m + 1) (by omega), hb (m + 1) (by omega), show a (m + 1 + 1) = b (m + 1 + 1) from ih.2, ih.1]\n  intro n hn\n  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩\n  exact (key m).1","recipe_id":"textbook.school_sequences.three_term_uniqueness","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (a b : ℕ → ℝ) (F : ℕ → ℝ → ℝ → ℝ), a 1 = b 1 → a 2 = b 2 → (∀ n : ℕ, 1 ≤ n → a (n + 2) = F n (a (n + 1)) (a n)) → (∀ n : ℕ, 1 ≤ n → b (n + 2) = F n (b (n + 1)) (b n)) → ∀ n : ℕ, 1 ≤ n → a n = b n","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}