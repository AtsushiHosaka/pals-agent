{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro ω a b c h3 h1\n  have h : ω ^ 2 + ω + 1 = 0 := by\n    have : (ω - 1) * (ω ^ 2 + ω + 1) = 0 := by linear_combination h3\n    exact (mul_eq_zero.mp this).resolve_left (sub_ne_zero.mpr h1)\n  linear_combination -(a + b + c) * (a * b + a * c + (b ^ 2 + c ^ 2) * (ω - 1) + b * c * (ω ^ 2 - ω + 1)) * h","recipe_id":"textbook.school_vectors_complex.cube_root_factorization_sum_cubes","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (ω a b c : ℂ), ω ^ 3 = 1 → ω ≠ 1 → a ^ 3 + b ^ 3 + c ^ 3 - 3 * a * b * c = (a + b + c) * (a + ω * b + ω ^ 2 * c) * (a + ω ^ 2 * b + ω * c)","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}