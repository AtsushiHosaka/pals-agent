{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro a b c h h₁ h₂ h₃\n  have e₂ : b / (b * c + b + 1) = a * b / (a * b + a + 1) := by\n    rw [div_eq_div_iff h₂ h₁]\n    linear_combination (-b) * h\n  have e₃ : c / (c * a + c + 1) = 1 / (a * b + a + 1) := by\n    rw [div_eq_div_iff h₃ h₁]\n    linear_combination h\n  rw [e₂, e₃, ← add_div, ← add_div]\n  rw [div_eq_one_iff_eq h₁]\n  ring","recipe_id":"textbook.school_polynomials.cyclic_fraction_sum_with_product_one","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (a b c : ℝ), a * b * c = 1 → a * b + a + 1 ≠ 0 → b * c + b + 1 ≠ 0 → c * a + c + 1 ≠ 0 → a / (a * b + a + 1) + b / (b * c + b + 1) + c / (c * a + c + 1) = 1","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}