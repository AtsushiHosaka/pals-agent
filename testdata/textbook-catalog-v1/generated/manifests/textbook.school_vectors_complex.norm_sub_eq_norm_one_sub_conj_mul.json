{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro z a h\n  have h1 : (starRingEnd ℂ) z * z = 1 := by\n    rw [Complex.conj_mul', h]; simp\n  have e : 1 - (starRingEnd ℂ) a * z = (starRingEnd ℂ) (z - a) * z := by\n    rw [map_sub, sub_mul, h1]\n  rw [e, norm_mul, h, mul_one, RCLike.norm_conj]","recipe_id":"textbook.school_vectors_complex.norm_sub_eq_norm_one_sub_conj_mul","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ z a : ℂ, ‖z‖ = 1 → ‖z - a‖ = ‖1 - (starRingEnd ℂ) a * z‖","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}