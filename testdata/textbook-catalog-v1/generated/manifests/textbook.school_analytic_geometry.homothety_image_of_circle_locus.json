{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro k p q a b r x y hk\n  constructor\n  · rintro ⟨x₀, y₀, h, rfl, rfl⟩\n    linear_combination k ^ 2 * h\n  · intro h\n    refine ⟨p + (x - p) / k, q + (y - q) / k, ?_, ?_, ?_⟩\n    · have : (p + (x - p) / k - a) ^ 2 + (q + (y - q) / k - b) ^ 2 = ((x - (p + k * (a - p))) ^ 2 + (y - (q + k * (b - q))) ^ 2) / k ^ 2 := by\n        field_simp; ring\n      rw [this, h]; field_simp\n    · field_simp; ring\n    · field_simp; ring","recipe_id":"textbook.school_analytic_geometry.homothety_image_of_circle_locus","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (k p q a b r x y : ℝ), k ≠ 0 → ((∃ x₀ y₀ : ℝ, (x₀ - a) ^ 2 + (y₀ - b) ^ 2 = r ^ 2 ∧ x = p + k * (x₀ - p) ∧ y = q + k * (y₀ - q)) ↔ (x - (p + k * (a - p))) ^ 2 + (y - (q + k * (b - q))) ^ 2 = (k * r) ^ 2)","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}