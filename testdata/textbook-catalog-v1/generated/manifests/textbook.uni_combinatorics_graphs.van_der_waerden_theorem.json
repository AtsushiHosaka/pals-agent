{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro κ _ C k\n  obtain ⟨a, ha, b, c, h⟩ := Combinatorics.exists_mono_homothetic_copy (Finset.range k) C\n  refine ⟨a, b, ha, c, fun i hi => ?_⟩\n  have := h i (Finset.mem_range.mpr hi)\n  rw [← this, smul_eq_mul, add_comm, mul_comm]","recipe_id":"textbook.uni_combinatorics_graphs.van_der_waerden_theorem","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (κ : Type*) [Finite κ] (C : ℕ → κ) (k : ℕ), ∃ a b : ℕ, 0 < a ∧ ∃ c : κ, ∀ i, i < k → C (b + i * a) = c","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}