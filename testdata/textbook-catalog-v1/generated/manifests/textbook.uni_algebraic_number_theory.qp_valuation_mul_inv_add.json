{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro p _ x y hx hy\n  exact ⟨Padic.valuation_mul hx hy, Padic.valuation_inv x, fun h => Padic.le_valuation_add h⟩","recipe_id":"textbook.uni_algebraic_number_theory.qp_valuation_mul_inv_add","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (p : ℕ) [Fact p.Prime] (x y : Padic p), x ≠ 0 → y ≠ 0 → (x * y).valuation = x.valuation + y.valuation ∧ x⁻¹.valuation = -x.valuation ∧ (x + y ≠ 0 → min x.valuation y.valuation ≤ (x + y).valuation)","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}