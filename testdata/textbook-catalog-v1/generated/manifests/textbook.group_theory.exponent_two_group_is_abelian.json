{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro G _ h a b\n  have hinv : ∀ g : G, g⁻¹ = g := fun g => inv_eq_of_mul_eq_one_left (by rw [← pow_two]; exact h g)\n  calc a * b = (a * b)⁻¹ := (hinv _).symm\n    _ = b⁻¹ * a⁻¹ := mul_inv_rev _ _\n    _ = b * a := by rw [hinv, hinv]","recipe_id":"textbook.group_theory.exponent_two_group_is_abelian","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (G : Type*) [Group G], (∀ g : G, g ^ 2 = 1) → ∀ a b : G, a * b = b * a","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}