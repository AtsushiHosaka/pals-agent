{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro a p q x ha ha1 hx\n  constructor\n  · intro h\n    exact ⟨Real.logb a x, h, (Real.rpow_logb ha ha1 hx).symm⟩\n  · rintro ⟨t, ht, rfl⟩\n    rw [Real.logb_rpow ha ha1]\n    exact ht","recipe_id":"textbook.school_exp_log.logb_quadratic_substitution","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (a p q x : ℝ), 0 < a → a ≠ 1 → 0 < x → ((Real.logb a x) ^ 2 + p * Real.logb a x + q = 0 ↔ ∃ t : ℝ, t ^ 2 + p * t + q = 0 ∧ x = a ^ t)","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}