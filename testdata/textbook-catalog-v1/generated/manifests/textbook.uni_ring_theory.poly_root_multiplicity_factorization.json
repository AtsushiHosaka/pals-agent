{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro A _ _ f a hf\n  obtain ⟨g, h1, h2⟩ := Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd f hf a\n  exact ⟨_, g, h1, fun h => h2 (Polynomial.dvd_iff_isRoot.mpr h)⟩","recipe_id":"textbook.uni_ring_theory.poly_root_multiplicity_factorization","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (A : Type*) [CommRing A] [Nontrivial A] (f : Polynomial A) (a : A), f ≠ 0 → ∃ (m : ℕ) (g : Polynomial A), f = (Polynomial.X - Polynomial.C a) ^ m * g ∧ g.eval a ≠ 0","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}