{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro a b c p x ha ha1 hb hc\n  rw [← Real.logb_mul hb.ne' hc.ne']\n  exact (Real.logb_eq_iff_rpow_eq ha ha1 (mul_pos hb hc)).trans eq_comm","recipe_id":"textbook.school_exp_log.logb_sum_equation_under_true_number_condition","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (a b c p x : ℝ), 0 < a → a ≠ 1 → 0 < x + b → 0 < x + c → (Real.logb a (x + b) + Real.logb a (x + c) = p ↔ (x + b) * (x + c) = a ^ p)","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}