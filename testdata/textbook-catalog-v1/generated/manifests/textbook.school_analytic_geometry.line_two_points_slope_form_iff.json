{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro x₁ y₁ x₂ y₂ x y h\n  have hd : x₂ - x₁ ≠ 0 := sub_ne_zero.mpr (Ne.symm h)\n  constructor\n  · intro hy\n    rw [hy]; field_simp; ring\n  · intro hy\n    field_simp\n    linear_combination hy","recipe_id":"textbook.school_analytic_geometry.line_two_points_slope_form_iff","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (x₁ y₁ x₂ y₂ x y : ℝ), x₁ ≠ x₂ → (y = y₁ + (y₂ - y₁) / (x₂ - x₁) * (x - x₁) ↔ (x₂ - x₁) * (y - y₁) = (y₂ - y₁) * (x - x₁))","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}