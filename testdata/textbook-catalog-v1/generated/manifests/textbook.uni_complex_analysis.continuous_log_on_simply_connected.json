{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro g U hU hs hg h0\n  obtain ⟨f, h1, h2⟩ := Complex.exists_continuousOn_eqOn_exp_comp hs hU hg (by\n    rintro ⟨z, hz, hz0⟩\n    exact h0 z hz hz0)\n  exact ⟨f, h1, fun z hz => h2 hz⟩","recipe_id":"textbook.uni_complex_analysis.continuous_log_on_simply_connected","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (g : ℂ → ℂ) (U : Set ℂ), IsOpen U → IsSimplyConnected U → ContinuousOn g U → (∀ z ∈ U, g z ≠ 0) → ∃ f : ℂ → ℂ, ContinuousOn f U ∧ ∀ z ∈ U, Complex.exp (f z) = g z","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}