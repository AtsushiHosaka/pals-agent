{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro a r h\n  have key : ∀ m : ℕ, a (m + 1) = a 1 * r ^ m := by\n    intro m\n    induction m with\n    | zero => simp\n    | succ m ih =>\n      rw [h (m + 1) (by omega), ih, pow_succ]\n      ring\n  intro n hn\n  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩\n  simpa using key m","recipe_id":"textbook.school_sequences.geom_general_term","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (a : ℕ → ℝ) (r : ℝ), (∀ n : ℕ, 1 ≤ n → a (n + 1) = r * a n) → ∀ n : ℕ, 1 ≤ n → a n = a 1 * r ^ (n - 1)","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}