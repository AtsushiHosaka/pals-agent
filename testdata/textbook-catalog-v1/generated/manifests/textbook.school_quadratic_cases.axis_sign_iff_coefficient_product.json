{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro a b ha\n  have hA : 0 < 2 * a ^ 2 := by positivity\n  have key : -b / (2 * a) * (2 * a ^ 2) = -(a * b) := by\n    field_simp\n  refine ⟨?_, ?_, ?_⟩\n  · rw [← mul_pos_iff_of_pos_right hA, key]\n    constructor <;> intro h <;> linarith\n  · rw [← neg_pos, ← mul_pos_iff_of_pos_right hA, neg_mul, key]\n    constructor <;> intro h <;> linarith\n  · rw [div_eq_zero_iff]\n    simp [ha]","recipe_id":"textbook.school_quadratic_cases.axis_sign_iff_coefficient_product","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (a b : ℝ), a ≠ 0 → (0 < -b / (2 * a) ↔ a * b < 0) ∧ (-b / (2 * a) < 0 ↔ 0 < a * b) ∧ (-b / (2 * a) = 0 ↔ b = 0)","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}