{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro a L K hK h ε hε\n  obtain ⟨N, hN⟩ := h (ε / (2 * K)) (by positivity)\n  refine ⟨N, fun n hn => lt_of_le_of_lt (hN n hn) ?_⟩\n  have : K * (ε / (2 * K)) = ε / 2 := by field_simp\n  rw [this]; linarith","recipe_id":"textbook.uni_analysis_foundations.seq_limit_eps_scaled","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (a : ℕ → ℝ) (L K : ℝ), 0 < K → (∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ n, N ≤ n → |a n - L| ≤ K * ε) → ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ n, N ≤ n → |a n - L| < ε","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}