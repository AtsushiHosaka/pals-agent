{"author_profile":{"schema_version":"pals.recipe-author-profile.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102"},"environment":{"namespace":null,"opens":[]},"imports":["Mathlib"],"kind":"exact_target_proof","proof_body":"by\n  intro a b c p x\n  have e : (a * x ^ 2 + b * x + c) - ((a * p ^ 2 + b * p + c) + (2 * a * p + b) * (x - p)) = a * (x - p) ^ 2 := by ring\n  refine ⟨e, fun ha => ?_⟩\n  constructor\n  · intro h\n    have h0 : a * (x - p) ^ 2 = 0 := by rw [← e, h]; ring\n    have := (mul_eq_zero.1 h0).resolve_left ha\n    exact sub_eq_zero.1 (pow_eq_zero_iff (two_ne_zero)|>.1 this)\n  · rintro rfl\n    ring","recipe_id":"textbook.school_quadratic_cases.tangent_line_difference_and_unique_contact","revision":1,"schema_version":"pals.recipe-authoring-manifest.v1","source_author_principal":"pals.principal.v1/claude/textbook-catalog-20261102","target_source":"∀ (a b c p x : ℝ), (a * x ^ 2 + b * x + c) - ((a * p ^ 2 + b * p + c) + (2 * a * p + b) * (x - p)) = a * (x - p) ^ 2 ∧ (a ≠ 0 → (a * x ^ 2 + b * x + c = (a * p ^ 2 + b * p + c) + (2 * a * p + b) * (x - p) ↔ x = p))","toolchain":{"fingerprint":{"lake_manifest_sha256":"290f048c4a499d34a3b21f8db30ade48a2b8d05b0fe79709f1868fa6748944fa","lean_version":"leanprover/lean4:v4.32.0-rc1","materializer_version":"pals.recipe-materializer.v1","schema_version":"pals.lean-toolchain-fingerprint.v1","verifier_sha256":"8a13da18825fc857f150220dc7aec489318dc7d2354a05bb955207e4764f284f"},"toolchain_id":"lean-4.32.0-rc1-mathlib-8b62164d-aws-v2"}}