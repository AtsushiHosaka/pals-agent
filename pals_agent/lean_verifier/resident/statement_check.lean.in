-- Parse-only statement check (layer 1).  Verbatim from scripts/eval/warm_worker.lean;
-- tests/unit/test_resident_lean.py keeps the two in step.
/-- Syntax node kinds a proposition may contain (parse level).  Everything else is refused.
Excluded on purpose: `by`, `show`, `from`, `let`, `have`, `do`, `match`, quotations, anonymous
constructors, `·`, structure instances, term-position elaborators (`type_of%`, `binop%`, `by_elab`,
`%[ ]`, ...), attributes and every command. -/
-- BEGIN ALLOWED_KINDS (generated by scripts/eval/gen_allowed_kinds.py, reviewed by hand)
def allowedKinds : List Name := [`Batteries.ExtendedBinder.extBinder,
   `Batteries.ExtendedBinder.extBinders,
   `BigOperators.bigOpBinder,
   `BigOperators.bigOpBinders,
   `BigOperators.bigsum,
   `CategoryTheory.«term_≫_»,
   `Lean.Elab.Term.«termType*»,
   `Lean.Parser.Term.app,
   `Lean.Parser.Term.arrow,
   `Lean.Parser.Term.basicFun,
   `Lean.Parser.Term.depArrow,
   `Lean.Parser.Term.explicitBinder,
   `Lean.Parser.Term.explicitUniv,
   `Lean.Parser.Term.forall,
   `Lean.Parser.Term.fun,
   `Lean.Parser.Term.hole,
   `Lean.Parser.Term.hygienicLParen,
   `Lean.Parser.Term.implicitBinder,
   `Lean.Parser.Term.instBinder,
   `Lean.Parser.Term.optEllipsis,
   `Lean.Parser.Term.paren,
   `Lean.Parser.Term.proj,
   `Lean.Parser.Term.prop,
   `Lean.Parser.Term.sort,
   `Lean.Parser.Term.strictImplicitBinder,
   `Lean.Parser.Term.structInst,
   `Lean.Parser.Term.structInstField,
   `Lean.Parser.Term.structInstFields,
   `Lean.Parser.Term.structInstLVal,
   `Lean.Parser.Term.tuple,
   `Lean.Parser.Term.type,
   `Lean.Parser.Term.typeAscription,
   `Lean.Parser.Term.typeSpec,
   `Lean.binderIdent,
   `Lean.explicitBinders,
   `Lean.unbracketedExplicitBinders,
   `Lean.«binderPred∈_»,
   `Lean.«term∀__,_»,
   `Lean.«term∃__,_»,
   `Mathlib.Meta.SetNotationForOrder.subsetStx',
   `Mathlib.Meta.setBuilder,
   `Mathlib.Notation.«term∃!_,_»,
   `Matrix.matrixNotation,
   `MeasureTheory.«term∀ᵐ_,_»,
   `MeasureTheory.«term∫_,_»,
   `choice,
   `fieldIdx,
   `group,
   `hygieneInfo,
   `null,
   `num,
   `scientific,
   `termIfThenElse,
   `termℂ,
   `termℕ,
   `termℚ,
   `termℝ,
   `termℤ,
   `«term-_»,
   `«term_%_»,
   `«term_*_»,
   `«term_+_»,
   `«term_-_»,
   `«term_/_»,
   `«term_<_»,
   `«term_=_»,
   `«term_>_»,
   `«term_\_»,
   `«term_^_»,
   `«term_×_»,
   `«term_ᶜ»,
   `«term_•_»,
   `«term_⁻¹»,
   `«term_→L[_]_»,
   `«term_→ₗ[_]_»,
   `«term_↔_»,
   `«term_∈_»,
   `«term_∉_»,
   `«term_∘_»,
   `«term_∣_»,
   `«term_∧_»,
   `«term_∨_»,
   `«term_∩_»,
   `«term_∪_»,
   `«term_≃_»,
   `«term_≠_»,
   `«term_≡_[MOD_]»,
   `«term_≤_»,
   `«term_≥_»,
   `«term_≫_»,
   `«term_⊂_»,
   `«term_⊃_»,
   `«term_⊆_»,
   `«term_⊇_»,
   `«term_⊓_»,
   `«term_⊔_»,
   `«term_⟶_»,
   `«term{_}»,
   `«term|___|»,
   `«term¬_»,
   `«term‖_‖»,
   `«term∃_,_»,
   `«term∅»,
   `«term∫_In_.._,_»,
   `«term⊤»,
   `«term⊥»]
-- END ALLOWED_KINDS

/-- Namespaces whose declarations are never admitted in a statement: code, monads, elaborators. -/
def badNamespaces : List Name :=
  [`Lean, `IO, `System, `Std.Internal, `Std.Tactic, `Elab, `Meta, `Tactic, `Parser, `Macro,
   `Mathlib.Tactic, `Mathlib.Meta, `Mathlib.Command, `Aesop, `Batteries.Tactic, `Qq,
   `ProofWidgets, `Plausible, `Std.Do, `ST, `EIO, `BaseIO, `EStateM, `StateT, `ReaderT,
   `ExceptT, `StateRefT, `ForIn, `Monad, `MonadLift, `MonadExcept, `Task, `Thunk, `Syntax,
   `TSyntax, `Dynamic, `ByteArray, `FloatArray, `Float, `unsafeCast, `unsafeBaseIO,
   `unsafeIO, `ptrAddrUnsafe, `withPtrEq, `dbgTrace, `dbgTraceIfShared, `dbgSleep, `panic,
   `panicCore, `outOfBounds, `lcProof, `lcUnreachable]

def nameIsBad (n : Name) : Bool :=
  badNamespaces.any (·.isPrefixOf n) || n.isInternal || n.isInaccessibleUserName

/-- A constant is admitted only if it is a plain mathematical declaration.  `@[extern]` and
`@[implemented_by]` are NOT grounds for refusal: `Nat.gcd` is extern, and a statement is never
run (no `#eval`, no `by_elab`: their syntax kinds are not in the allow-list). -/
def constOk (env : Environment) (n : Name) : Bool :=
  match env.find? n with
  | none => false
  | some ci =>
    !(nameIsBad n) && !ci.isUnsafe && !ci.isPartial
      && !(ci.type.getUsedConstants.any nameIsBad)

/-- Namespaces of the core data types a bound variable of an allowed statement can have. -/
def fieldNamespaces : List Name :=
  [`Nat, `Int, `List, `Array, `Option, `String, `Fin, `Prod, `Sum, `Subtype, `Set, `Finset,
   `Multiset, `Rat, `Real, `Complex, `Function]

/-- Field names that, applied to a bound variable of one of those types (`n.forM`, `l.mapM`),
would select a declaration refused by its full name (`Nat.forM`): unsafe, partial, or a type that
mentions a bad namespace.  Only these core namespaces are scanned: types of other structures are
unknown without elaboration, and a name-based list over all of Mathlib refuses ordinary fields
(`f.comp g`, `.map`).  So this is a narrow, name-based check, NOT type resolution: a field of a
bound variable whose type is in another namespace is not checked.  Computed once per process. -/
def badFieldNames (env : Environment) : Std.HashSet String :=
  env.constants.fold (init := {}) fun acc n ci =>
    match n with
    | .str pre s =>
      if fieldNamespaces.any (· == pre) && !n.isInternal &&
          (ci.isUnsafe || ci.isPartial ||
            ci.type.getUsedConstants.any (fun c => nameIsBad c && !c.isInternal)) then
        acc.insert s
      else acc
    | _ => acc

partial def checkSyntax (env : Environment) (badFields : Std.HashSet String)
    (opens : List OpenDecl) (stx : Syntax) : Except String Unit :=
  match stx with
  | .missing => throw "missing syntax"
  | .atom _ val =>
    if val == "%" || val.endsWith "%" || val.endsWith "%[" then
      if val == "%" then pure () else throw s!"elaborator token {val}"
    else pure ()
  | .ident _ _ id _ =>
    if id.getRoot == `_root_ then throw "_root_ prefix"
    else
      let candidates := ResolveName.resolveGlobalName env {} Name.anonymous opens id
      match candidates.find? (fun (c, fields) =>
          !(constOk env c) || fields.any badFields.contains) with
      | some (c, _) => throw s!"identifier {id} resolves to excluded constant or field of {c}"
      | none =>
        -- not a global name: a bound variable with field access `n.forM`
        if candidates.isEmpty then
          match id.components.drop 1 |>.find? (fun c => match c with
              | .str _ s => badFields.contains s | _ => false) with
          | some c => throw s!"field {c} of a bound variable selects an excluded declaration"
          | none => pure ()
        else pure ()
  | .node _ kind args =>
    if !(allowedKinds.contains kind) then throw s!"syntax kind {kind}"
    else
      if kind == `Lean.Parser.Term.proj then
        match args.back? with
        | some (.ident _ _ f _) =>
          if f.components.any (fun c => match c with
              | .str _ s => badFields.contains s | _ => false) then
            throw s!"field {f} selects an excluded declaration"
          else args.forM (checkSyntax env badFields opens)
        | _ => args.forM (checkSyntax env badFields opens)
      else args.forM (checkSyntax env badFields opens)

partial def collectKinds (stx : Syntax) (acc : Array Name) : Array Name :=
  match stx with
  | .node _ kind args => args.foldl (fun a s => collectKinds s a) (acc.push kind)
  | _ => acc

def parseTerm (env : Environment) (text : String) : Except String Syntax :=
  Parser.runParserCategory env `term text "<statement>"
