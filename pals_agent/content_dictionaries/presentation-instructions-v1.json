  "patterns": [
    {
      "id": "en.write_in_language",
      "re": "(?:(?:,|;|\\band\\b|\\balso\\b|\\bthen\\b|\\bplease\\b|\\bkindly\\b)\\s*)*(?:(?:please\\s+)?(?:do\\s+not|don't|never)\\s+)?\\b(?:write|answer|respond|reply|present|provide|give|describe|output|format|compose|state|include)\\s+(?:(?:the|a|an|entire|whole|full|complete|completely|proposition|propositions|statement|statements|theorem|claim|proof|proofs|explanation|answer|solution|and|both|all|everything|your|response|reply|it|them|this|that|its|each|every|step|steps|of|argument|reasoning|result|results|text|writing|also|as|well|state|give|present|provide|include|write|describe|detailed|careful|carefully|clearly)\\s+)*(?:in|using)\\s+(?:the\\s+)?(?:{LANG_EN})(?:\\s*(?:,|and|or|/|&)\\s*(?:{LANG_EN}))*(?:\\s+language)?\\b(?:\\s+only(?!\\s+if\\b))?"
    },
    {
      "id": "en.in_language",
      "re": "(?:,\\s*)?\\b(?:in|using)\\s+(?:the\\s+)?(?:{LANG_EN})(?:\\s*(?:,|and|or|/|&)\\s*(?:{LANG_EN}))*(?:\\s+language)?\\b(?:\\s+only(?!\\s+if\\b))?"
    },
    {
      "id": "en.language_only",
      "re": "\\b(?:{LANG_EN})\\s+only\\b|\\((?:in\\s+)?(?:{LANG_EN})\\)"
    },
    {
      "id": "en.format",
      "re": "(?:,\\s*)?\\b(?:step[- ]by[- ]step|in\\s+detail|in\\s+detailed\\s+steps|briefly|concisely|in\\s+simple\\s+terms|in\\s+plain\\s+(?:language|words)|for\\s+(?:a\\s+)?beginners?)\\b"
    },
    {
      "id": "ja.write_in_language",
      "re": "(?:(?:こと)?(?:を|は|が))?[、，]?(?:(?:命題|証明|説明|回答|解答|答え|解説|全体|全て|すべて|全文|全部)(?:と|も|は|を|の|、)*)*(?:{LANG_CJK})\\s*で\\s*(?:書いて|書け|書いてください|書き下して|答えて|回答して|出力して|記述して|述べて|お願いします|お願い|ください)+",
      "join": ""
    },
    {
      "id": "ja.in_language",
      "re": "(?:(?:{LANG_CJK})\\s*(?:か|と|や|または|あるいは|、)\\s*)*(?:{LANG_CJK})\\s*で(?:の|なくて?|(?:書|答|出力|回答|記述)(?:かないで|くな|しないで))?",
      "join": ""
    },
    {
      "id": "ja.format",
      "re": "丁寧に|詳しく|わかりやすく|分かりやすく|簡潔に|簡単に|ステップごとに|ステップバイステップで|初心者向けに",
      "join": ""
    },
    {
      "id": "zh.write_in_language",
      "re": "(?:请|請)?(?:用|以|使用)(?:{LANG_CJK})(?:写出|寫出|写|寫|回答|作答|书写|書寫)(?:全部|所有|整个|整個)?(?:命题|命題|证明|證明|和|与|與|、)*",
      "join": ""
    },
    {
      "id": "zh.in_language",
      "re": "(?:请|請)?(?:用|以|使用)(?:{LANG_CJK})",
      "join": ""
    },
    {
      "id": "zh.format",
      "re": "详细地?|詳細地?|简洁|簡潔|分步|逐步",
      "join": ""
    }
  ],
