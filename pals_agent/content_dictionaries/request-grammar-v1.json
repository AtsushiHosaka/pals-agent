  "filler_patterns": [
    "(?:please\\s+)?(?:write|answer|respond|reply|explain|state|give)\\s+(?:(?:the|a|an|entire|whole|full|complete|proposition|statement|theorem|proof|explanation|answer|and|both|all|everything|your|response|reply|it|them)\\s+)*in\\s+(?:english|japanese|chinese|simplified\\s+chinese|traditional\\s+chinese)(?![a-z])",
    "(?:命題|証明|説明|回答|解答|全体|全て|すべて|全文|と|も|は|を|の)*(?:英語|日本語|中国語|簡体字中国語|繁体字中国語|中国語簡体字|中国語繁体字)\\s*で\\s*(?:書いて|書け|書いてください|答えて|出力して|記述して|ください|お願いします|お願い)*",
    "(?:请|請)?(?:用|以)(?:英语|英文|英語|日语|日語|日文|中文|简体中文|繁体中文|繁體中文)(?:写出|寫出|写|寫|回答|说明|說明|作答|书写)(?:全部|所有|整个|整個)?(?:命题|命題|证明|證明)*(?:和|与|與)*(?:证明|證明|说明|說明)*"
  ]
