{
  "schema_version": "pals.request-grammar.v1",
  "notes": "Closed vocabulary for turning a learner request into one Lean proposition without a model. A request is accepted only if every character is consumed by an entry below; anything else is a miss and the request keeps its existing route. To widen the grammar, add rows here (a function, a property, a domain, a filler word); no code change is needed for a new function or property that fits the templates. Forms are Python regular expressions applied to the normalized text (superscript digits are written as ^k, NFKC applied, lower-cased). The named group v is the variable letter; k and other slot groups are the parameters of the function. search_terms are the deterministic Recipe-search query words of a function or property. A property may name preferred_method: among Recipes that bind, those with that proof_method_tag are tried first. Output-language instructions (filler_patterns) draw on a closed set of words so that free text cannot ride along. Domain 'patterns' and 'filler_patterns' are regular expressions on the normalized text; 'forms' are literals (normalized when the table is built). A function binder may name the function symbol (group fn): standalone occurrences of that letter are then consumed too.",
  "variable": {
    "pattern": "[a-z]"
  },
  "numerals": {
    "kanji": {
      "零": 0,
      "〇": 0,
      "一": 1,
      "二": 2,
      "三": 3,
      "四": 4,
      "五": 5,
      "六": 6,
      "七": 7,
      "八": 8,
      "九": 9,
      "十": 10
    }
  },
  "functions": [
    {
      "id": "power",
      "lean_body": "{v} ^ {k}",
      "slots": {
        "k": "natural"
      },
      "forms": [
        {
          "re": "(?<![a-z0-9])(?P<v>[a-z])\\s*\\^\\s*\\{?\\s*(?P<k>[0-9]{1,9})\\s*\\}?(?![0-9])"
        },
        {
          "re": "(?<![a-z0-9])(?P<v>[a-z])\\s*の\\s*(?P<k>[0-9]{1,9})\\s*乗"
        },
        {
          "re": "(?<![a-z0-9])(?P<v>[a-z])\\s*の\\s*(?P<k>[零〇一二三四五六七八九十])\\s*乗",
          "numerals": "kanji"
        },
        {
          "re": "(?<![a-z0-9])(?P<v>[a-z])\\s+squared",
          "fixed": {
            "k": 2
          }
        },
        {
          "re": "(?<![a-z0-9])(?P<v>[a-z])\\s+cubed",
          "fixed": {
            "k": 3
          }
        },
        {
          "re": "(?<![a-z0-9])(?P<v>[a-z])\\s+to\\s+the\\s+(?:power\\s+(?:of\\s+)?)?(?P<k>[0-9]{1,9})(?![0-9])"
        },
        {
          "re": "(?<![a-z0-9])(?P<v>[a-z])\\s*の\\s*平方(?!根)",
          "fixed": {
            "k": 2
          }
        },
        {
          "re": "(?<![a-z0-9])(?P<v>[a-z])\\s*的\\s*平方(?!根)",
          "fixed": {
            "k": 2
          }
        },
        {
          "re": "(?<![a-z0-9])(?P<v>[a-z])\\s*的\\s*(?P<k>[零〇一二三四五六七八九十])\\s*次方",
          "numerals": "kanji"
        },
        {
          "re": "(?<![a-z0-9])(?P<v>[a-z])\\s*的\\s*(?P<k>[0-9]{1,9})\\s*次方"
        },
        {
          "re": "(?<![a-z0-9])(?P<v>[a-z])\\s*(?:\\^\\s*)?(?:squared|square)(?![a-z])",
          "fixed": {
            "k": 2
          }
        },
        {
          "re": "(?<![a-z0-9])(?P<v>[a-z])\\s*(?:\\^\\s*)?(?:cubed|cube)(?![a-z])",
          "fixed": {
            "k": 3
          }
        },
        {
          "re": "(?:平方関数|二乗関数|2乗関数|平方函数|二次方函数|squaring\\s+function|square\\s+function|the\\s+square\\s+map)",
          "fixed": {
            "k": 2
          },
          "variable": "x"
        }
      ],
      "search_terms": "power function exponent natural number x^n real"
    }
  ],
  "properties": [
    {
      "id": "continuous",
      "lean": "Continuous (fun {v} : ℝ => {body})",
      "forms": [
        "continuous function",
        "continuous",
        "continuity",
        "連続である",
        "連續函數",
        "连续函数",
        "連続関数",
        "連續的",
        "連續性",
        "连续性",
        "连续的",
        "連続性",
        "连续",
        "連続",
        "連續"
      ],
      "search_terms": "continuous continuity",
      "preferred_method": "epsilon_delta"
    }
  ],
  "function_binders": [
    "(?P<fn>[a-z])\\s*\\(\\s*(?P<v>[a-z])\\s*\\)\\s*=",
    "y\\s*=",
    "(?P<fn>[a-z])\\s*:\\s*r\\s*(?:→|->)\\s*r",
    "(?P<fn>[a-z])\\s*:\\s*(?:ℝ|r)\\s*(?:→|->)\\s*(?:ℝ|r)"
  ],
  "domains": [
    {
      "id": "real_line",
      "forms": [
        "実数全体で",
        "実数全体",
        "実数上で",
        "実数上",
        "全実数で",
        "ℝ上で",
        "ℝ上",
        "r上で",
        "r上",
        "on the real line",
        "on the reals",
        "on ℝ",
        "everywhere",
        "on r",
        "in r",
        "over r",
        "全ての実数で",
        "すべての実数で",
        "在实数上",
        "在实数范围内",
        "在r上",
        "在实数集上",
        "實數上",
        "在實數上"
      ],
      "patterns": [
        "(?:at|in|on)\\s+(?:every|each|all)\\s+(?:points?|real\\s+numbers?|reals?)(?:\\s+of\\s+(?:the\\s+)?(?:r|real\\s+(?:line|numbers))|\\s+in\\s+r)?",
        "for\\s+(?:every|all|each)\\s+(?:real\\s+(?:numbers?\\s+)?)?[a-z]?(?:\\s+in\\s+r)?",
        "on\\s+(?:the\\s+)?(?:whole\\s+)?(?:real\\s+(?:line|numbers?)|reals)",
        "(?:r|実数)\\s*の\\s*(?:すべて|全て|全)の\\s*点\\s*(?:で|において)",
        "(?:すべて|全て|全)の\\s*(?:実数|点)\\s*(?:x\\s*)?(?:で|において)",
        "(?:在)?(?:所有|每一?个?)(?:实数|點|点)(?:处|處|上)",
        "(?:r|実数|实数|實數)\\s*上\\s*(?:で|において|的)?"
      ]
    }
  ],
  "fillers": [
