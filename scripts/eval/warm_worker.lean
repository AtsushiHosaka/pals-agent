/-- Namespaces whose declarations are never admitted in a statement: code, monads, elaborators. -/
def badNamespaces : List Name :=
  [`Lean, `IO, `System, `Std.Internal, `Std.Tactic, `Elab, `Meta, `Tactic, `Parser, `Macro,
   `Mathlib.Tactic, `Mathlib.Meta, `Mathlib.Command, `Aesop, `Batteries.Tactic, `Qq,
   `ProofWidgets, `Plausible, `Std.Do, `ST, `EIO, `BaseIO, `EStateM, `StateT, `ReaderT,
   `ExceptT, `StateRefT, `ForIn, `Monad, `MonadLift, `MonadExcept, `Task, `Thunk, `Syntax,
   `TSyntax, `Dynamic, `ByteArray, `FloatArray, `Float, `unsafeCast, `unsafeBaseIO,
   `unsafeIO, `ptrAddrUnsafe, `withPtrEq, `dbgTrace, `dbgTraceIfShared, `dbgSleep, `panic,
   `panicCore, `outOfBounds, `lcProof, `lcUnreachable]

def nameIsBad (n : Name) : Bool :=
  badNamespaces.any (·.isPrefixOf n) || n.isInternal || n.isInaccessibleUserName

/-- A constant is admitted only if it is a plain mathematical declaration.  `@[extern]` and
`@[implemented_by]` are NOT grounds for refusal: `Nat.gcd` is extern, and a statement is never
run (no `#eval`, no `by_elab`: their syntax kinds are not in the allow-list). -/
def constOk (env : Environment) (n : Name) : Bool :=
  match env.find? n with
  | none => false
  | some ci =>
    !(nameIsBad n) && !ci.isUnsafe && !ci.isPartial
      && !(ci.type.getUsedConstants.any nameIsBad)

partial def checkSyntax (env : Environment) (opens : List OpenDecl) (stx : Syntax) :
    Except String Unit :=
  match stx with
  | .missing => throw "missing syntax"
  | .atom _ val =>
    if val == "%" || val.endsWith "%" || val.endsWith "%[" then
      if val == "%" then pure () else throw s!"elaborator token {val}"
    else pure ()
  | .ident _ _ id _ =>
    if id.getRoot == `_root_ then throw "_root_ prefix"
    else
      let candidates := ResolveName.resolveGlobalName env {} Name.anonymous opens id
      -- unresolved: a bound variable (autoImplicit is off, an unknown name fails elaboration)
      match candidates.find? (fun (c, _) => !(constOk env c)) with
      | some (c, _) => throw s!"identifier {id} resolves to excluded constant {c}"
      | none => pure ()
  | .node _ kind args =>
    if !(allowedKinds.contains kind) then throw s!"syntax kind {kind}"
    else args.forM (checkSyntax env opens)

partial def collectKinds (stx : Syntax) (acc : Array Name) : Array Name :=
  match stx with
  | .node _ kind args => args.foldl (fun a s => collectKinds s a) (acc.push kind)
  | _ => acc

def parseTerm (env : Environment) (text : String) : Except String Syntax :=
  Parser.runParserCategory env `term text "<statement>"

unsafe def run : IO Unit := do
  enableInitializersExecution
  initSearchPath (← findSysroot)
  let env ← importModules #[{ module := `Mathlib }] {} 0 (loadExts := true)
  let stdin ← IO.getStdin
  let stdout ← IO.getStdout
  stdout.putStrLn "PALS_READY"
  stdout.flush
  repeat
    let line ← stdin.getLine
    if line.isEmpty then break
    let request := line.trimAscii.toString
    if request.startsWith "CHECK " || request.startsWith "KINDS " then
      let path := (request.drop 6).toString
      let lines := (← IO.FS.readFile path).splitOn "\n"
      let opens := ((lines.getD 0 "").splitOn " ").filter (· ≠ "")
        |>.map (fun n => OpenDecl.simple n.toName [])
      let term := lines.getD 1 ""
      match parseTerm env term with
      | .error e => stdout.putStrLn s!"PALS_CHECK_REFUSED parse error: {(e.replace "\n" " ").take 200}"
      | .ok stx =>
        if request.startsWith "KINDS " then
          for k in collectKinds stx #[] do stdout.putStrLn s!"KIND {k}"
        else
          match checkSyntax env opens stx with
          | .ok _ => stdout.putStrLn "PALS_CHECK_OK"
          | .error e => stdout.putStrLn s!"PALS_CHECK_REFUSED {e}"
      stdout.putStrLn s!"PALS_DONE {path}"
      stdout.flush
    else
      let path := request
      let src ← IO.FS.readFile path
      let inputCtx := Parser.mkInputContext src path
      let cmdState := Command.mkState env {} {}
      let s ← IO.processCommands inputCtx {} cmdState
      for msg in s.commandState.messages.toList do
        stdout.putStr (← msg.toString)
      stdout.putStrLn s!"PALS_DONE {path}"
      stdout.flush

@[implemented_by run] opaque mainSafe : IO Unit

def main : IO Unit := mainSafe
